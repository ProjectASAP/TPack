{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "uid": "tpack-traces",
  "title": "Traces",
  "tags": ["t-pack"],
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Tempo",
        "type": "datasource",
        "query": "tempo",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Span rate by service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "tempo", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${datasource}" },
          "queryType": "traceql",
          "query": "{} | rate() by (resource.service.name)"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error span rate by service",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "tempo", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${datasource}" },
          "queryType": "traceql",
          "query": "{ status = error } | rate() by (resource.service.name)"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Span duration percentiles (p50 / p95 / p99)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "tempo", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${datasource}" },
          "queryType": "traceql",
          "query": "{} | quantile_over_time(duration, 0.5, 0.95, 0.99)"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ns", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Top operations by span count (last 15m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "tempo", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${datasource}" },
          "queryType": "traceql",
          "query": "{} | count_over_time() by (name)"
        }
      ],
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } }
    }
  ]
}
